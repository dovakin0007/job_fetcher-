# --- Primary LLM: OpenCode inference (recommended), Ollama fallback ---
# Console key from https://opencode.ai/console (paid models or a Go
# subscription — free-tier models 403 from outside OpenCode).
OPENCODE_API_KEY=replace-me
# Model + the API family it speaks: openai for kimi/glm/minimax ...,
# anthropic for claude/qwen ..., gemini for gemini ...
OPENCODE_MODEL=kimi-k3
# OPENCODE_API_FAMILY=openai
# OPENCODE_BASE_URL=https://opencode.ai/inference
# Which flow uses what: opencode first, Ollama fallback when local.
# TAILOR_LLM_PROVIDER=both
# RESUME_LLM_PROVIDER=both

# Resume extraction provider: both (OpenCode first, then Ollama), opencode, ollama, or openai
RESUME_LLM_PROVIDER=both

# Ollama resume extraction (local fallback — keep a small model for offline use)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=your-instruct-model
# Legacy aliases are also accepted: LLM_BASE_URL and LLM_MODEL

# OpenAI resume extraction (cloud)
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=replace-me

# Optional job-match LLM reranking (separate settings)
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=your-instruct-model
# LLM_API_KEY=
LLM_RERANK_THRESHOLD=55

# Per-job tailored resume rewrite. Provider order and keys:
# TAILOR_LLM_PROVIDER=both  (tries opencode, openai, anthropic, gemini, ollama in order;
#   or pick one: opencode, ollama, openai, anthropic, gemini).
# Falls back to TAILOR_LLM_PROVIDER -> RESUME_LLM_PROVIDER -> both.
# OpenCode (recommended primary): set OPENCODE_API_KEY + OPENCODE_MODEL above.
# ANTHROPIC_API_KEY=replace-me
# ANTHROPIC_MODEL=claude-sonnet-4-5
# GEMINI_API_KEY=replace-me
# GEMINI_MODEL=gemini-2.0-flash
# Without any tailor key the endpoint returns the deterministic resume build.

# Structured job search via SerpApi (Google Jobs + Glassdoor; replaces Exa).
# Get a key at https://serpapi.com/manage-api-key
# SERPAPI_API_KEY=replace-me
# JSearch via RapidAPI (aggregated LinkedIn/Indeed/Glassdoor/ZipRecruiter).
# JSEARCH_API_KEY=replace-me
# Search keys are sealed with AES-256-GCM in SQLite (see below). Optional
# machine-local master key (64 hex chars). If unset, a random key is created
# at data/.master_key — back it up, or saved keys become unreadable.
# AGENT_MASTER_KEY=replace-me-with-64-hex-chars
# Web job search. Optional: keyless providers (Remotive + Arbeitnow) always run.
# Set a key for deeper coverage (SerpApi Google Jobs, Tavily, and/or Brave).
TAVILY_API_KEY=
BRAVE_API_KEY=
# SEARCH_RESULT_LIMIT=15
# Thin snippets are enriched to full page text (Tavily /extract), cached
# in SQLite for 30 days. Tune the cost/coverage tradeoff:
# SEARCH_ENRICH_MIN_CHARS=1200
# SEARCH_ENRICH_MAX=25
# Search pages are stored in SQLite. A new day soft-deletes older pages. A weekly cleanup removes rows deleted for 7 days.
# Posting quality gates (what "empty" cards mostly are). Thin bodies, unknown
# company, missing location, and zero skill overlap never become jobs, and
# already-stored ones are purged on the next discovery run.
# SEARCH_MIN_BODY_CHARS=120
# Maximum postings re-validated per discovery run (live-page check).
# SEARCH_VERIFY_MAX=60
# Per-check HTTP timeout (seconds); failures fail open (job kept).
# SEARCH_VERIFY_TIMEOUT_SECS=10
# Parallel legitimacy checks (separate lane from paced search traffic).
# SEARCH_VERIFY_INFLIGHT=10
# SEARCH_REQUIRE_COMPANY=1
# SEARCH_REQUIRE_LOCATION=1
# SEARCH_REQUIRE_SKILLS=1
# Business-directory pages (exporters, manufacturers with phone numbers and
# no hiring signal) are dropped as non-jobs, old and new.
# Gmail SSO (OAuth2, read-only mail). Preferred over app passwords.
# One-time setup: Google Cloud → APIs & Services → enable Gmail API →
# Credentials → Create OAuth client ID → type "Desktop app".
# Loopback http://127.0.0.1:8787 needs no redirect-URI registration.
# Then Sign in with Google from the Applications panel; the refresh token is
# sealed with AES-256-GCM in SQLite (never shown again).
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Recruiter-email outcome sync fallback (IMAP app password). The sync reads recent inbox mail,
# matches replies to tracked applications by company, and advances them to
# interview / offer / rejected. Gmail needs an app password, not your login.
# EMAIL_IMAP_HOST=imap.gmail.com
# EMAIL_IMAP_PORT=993
# EMAIL_IMAP_USER=
# EMAIL_IMAP_PASS=
# Polite search pacing (per-provider 429s with Retry-After + backoff):
# at most SEARCH_MAX_INFLIGHT concurrent search requests, at least
# SEARCH_MIN_GAP_MS between request starts per provider, SEARCH_MAX_RETRIES
# retries with backoff (honours Retry-After, capped by SEARCH_RETRY_CAP_SECS).
# Paginated fetching: SEARCH_QUERIES_PER_RUN caps how many HTTP fetches one
# discovery run performs (default 2 — about one query across the configured
# engines). Fetched pages are stored in SQLite; everything already cached is
# served every run, and the persisted offset moves on so the next run / page
# load fetches the following slice. Set 0 for fetch-all (old burst behaviour).
# SEARCH_MAX_INFLIGHT=2
# SEARCH_MIN_GAP_MS=300
# SEARCH_MAX_RETRIES=3
# SEARCH_RETRY_CAP_SECS=30
# SEARCH_QUERIES_PER_RUN=2

# Optional Greenhouse board tokens, comma-separated. A board URL saved from the
# dashboard is picked up from data/job_sources.json without this variable.
# GREENHOUSE_BOARDS=your-board-token
# GREENHOUSE_MAX_JOBS=40

# Optional ONNX (compile with --features onnx)
# EMBEDDING_MODEL=models/all-MiniLM-L6-v2.onnx
# TOKENIZER_JSON=models/tokenizer.json
